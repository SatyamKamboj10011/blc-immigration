{
  "name": "blc-immigration",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "i18n:check": "esbuild scripts/i18n-extract.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/scripts/i18n-extract.mjs && node node_modules/.cache/scripts/i18n-extract.mjs",
    "ai:eval": "esbuild scripts/ai-eval.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/scripts/ai-eval.mjs && node node_modules/.cache/scripts/ai-eval.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.33.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^6.4.3"
  }
}
